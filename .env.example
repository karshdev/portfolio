# Copy to .env and fill in. Never commit the filled-in file.

# --- AI terminal chat (required for the assistant to answer) ---
# OpenRouter API key - https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Only used for attribution on openrouter.ai/rankings.
# Quote any value containing spaces. ASCII only.
SITE_URL=https://your-domain.com
SITE_NAME="Your Name Portfolio"

# --- Contact form (the assistant's send_email tool) ---
# Without both of these the tool replies "email service not configured"
# and sends nothing. Resend API key - https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Inbox that visitor messages are delivered to
CONTACT_EMAIL=you@example.com
